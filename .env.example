# LLM provider: "openai" or "mock" (mock = deterministic, no API key, for tests/demo)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=4

# Routing
CONFIDENCE_THRESHOLD=0.70

# Storage
DB_PATH=data/careguard.db
INDEX_PATH=data/index